{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "data:push": "tsx --env-file=../../.env.production src/dataPush.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@gallery/shared": "workspace:*",
    "@sentry/node": "^11.10.0",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  }
}
