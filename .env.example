# Telegram. Leave BOT_TOKEN empty for local browser development as the dev user (id 1).
BOT_TOKEN=
MINI_APP_URL=
# Set PUBLIC_URL to use a webhook. Without it the bot uses long polling.
PUBLIC_URL=
BOT_WEBHOOK_SECRET=

# Database. Empty uses embedded PGlite in .data/pglite.
DATABASE_URL=

# Media. Empty S3_BUCKET stores files on local disk and serves them from /media.
MEDIA_BASE_URL=/media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional
# Photos per user; protects the free storage limit.
MAX_PHOTOS_PER_USER=300
# Owner for photos added before galleries were personal. Local development uses the dev user.
LEGACY_OWNER_ID=
SENTRY_DSN=
CORS_ORIGIN=

# Frontend, read at build time. Share links: https://t.me/<bot>/<app>
VITE_TG_APP_LINK=
VITE_SENTRY_DSN=
